@startuml ManiView - Diagramme de Séquence (Stop, Reset, Nudge)

!define MAIN_COLOR #5f93cf
!define SECONDARY_COLOR #e6effa

skinparam sequenceArrowThickness 2
skinparam roundcorner 10
skinparam maxMessageSize 150

actor Utilisateur
participant "UIController" as UI
participant "App" as App
participant "CycleEngine" as Engine
participant "AudioService" as Audio
participant "BarRenderer" as Bar
participant "CountdownController" as Countdown

== Scénario 1: Arrêt (Stop) ==

Utilisateur -> UI: Clique sur "Stop"
activate UI
UI -> App: _stop()
activate App

App -> App: nowPerf = performance.now()

App -> Engine: computePhaseMs(nowPerf, cycleStartPerf)
activate Engine
Engine --> App: phaseMs
deactivate Engine

App -> App: _pausedPhaseMs = clampNumber(phaseMs)
App -> App: _isPaused = true
App -> App: _running = false

note over App
  Après Stop, _running devient false,
  mais _isPaused reste true.
  Le cycle peut donc être repris
  sans appliquer immédiatement
  les paramètres modifiés.
end note

App -> UI: setStoppedState()
activate UI
UI -> UI: Active bouton Start\nDésactive bouton Stop\nDésactive boutons Nudge
deactivate UI

App -> App: _cancelLoop()\n(cancelAnimationFrame si _rafId existe)

App -> Audio: stopScheduler()
activate Audio
Audio -> Audio: clearInterval(_schedTimer)
deactivate Audio

App -> Audio: mute()
activate Audio
Audio -> Audio: gain.setValueAtTime(0, currentTime)
deactivate Audio

App -> Bar: render(_pausedPhaseMs, engine)
activate Bar
Bar -> Bar: Affiche barre à position pause
deactivate Bar

App -> Countdown: hide()
activate Countdown
deactivate Countdown

App -> UI: setPhaseText("Stopped")
activate UI
deactivate UI

deactivate App
deactivate UI

== Scénario 2: Réinitialisation (Reset) ==

Utilisateur -> UI: Clique sur "Réinitialiser"
activate UI
UI -> App: _reset()
activate App

App -> App: _running = false
App -> App: _cancelLoop()

App -> Audio: stopScheduler()
activate Audio
deactivate Audio

App -> Audio: mute()
activate Audio
deactivate Audio

App -> App: _isPaused = false
App -> App: _pausedPhaseMs = 0

App -> UI: readApneaMs()
activate UI
UI --> App: apneaMs
deactivate UI

App -> UI: readExpSecAsMs()
activate UI
UI --> App: expMs
deactivate UI

App -> Engine: setApnea(apneaMs, false)
activate Engine
Engine -> Engine: _apneaMs = apneaMs
Engine -> Engine: _activeApnea = apneaMs
deactivate Engine

App -> Engine: setExp(expMs, false)
activate Engine
Engine -> Engine: _expMs = expMs
Engine -> Engine: _activeExp = expMs
deactivate Engine

App -> Engine: reset()
activate Engine
Engine -> Engine: _phaseOffsetMs = 0
Engine -> Engine: _cycleIndex = 0
Engine -> Engine: _pendingApnea = null
Engine -> Engine: _pendingExp = null
Engine -> Engine: _hasPending = false
Engine -> Engine: _activeApnea = _apneaMs
Engine -> Engine: _activeExp = _expMs
deactivate Engine

App -> Countdown: hide()
activate Countdown
deactivate Countdown

App -> Bar: updateMarkers(engine)
activate Bar
Bar -> Bar: Recalcule les marqueurs
deactivate Bar

App -> Bar: render(0, engine)
activate Bar
Bar -> Bar: Remet barre à 0%
deactivate Bar

App -> UI: setPhaseText("Stopped")
activate UI
deactivate UI

App -> UI: setResetState()
activate UI
UI -> UI: Active bouton Start\nDésactive tous les autres
deactivate UI

deactivate App
deactivate UI

== Scénario 3: Saut à Sortie ==

Utilisateur -> UI: Clique sur "Saut → Sortie"
activate UI
UI -> App: _jumpToSortie()
activate App

App -> App: _running = false
App -> App: _cancelLoop()

App -> Audio: stopScheduler()
activate Audio
deactivate Audio

App -> Audio: mute()
activate Audio
deactivate Audio

App -> Engine: get apneaMs
activate Engine
Engine --> App: apneaMs
deactivate Engine

App -> App: _pausedPhaseMs = apneaMs
App -> App: _isPaused = true

App -> Engine: resetPhaseOffset()
activate Engine
deactivate Engine

App -> App: _cycleStartPerf = performance.now() - _pausedPhaseMs

App -> Countdown: hide()
activate Countdown
deactivate Countdown

App -> Bar: render(_pausedPhaseMs, engine)
activate Bar
Bar -> Bar: Positionne la barre au début de la sortie
deactivate Bar

App -> UI: setPhaseText("Stopped")
activate UI
deactivate UI

App -> UI: setJumpSortieState()
activate UI
UI -> UI: Active bouton Start et Reset\nDésactive Stop et boutons Nudge
deactivate UI

deactivate App
deactivate UI

== Scénario 4: Nudge (Décalage temporel) ==

Utilisateur -> UI: Clique sur "+ Nudge" ou "- Nudge"
activate UI
UI -> App: _nudge(deltaMs)
activate App

alt Application arrêtée (_running == false)
    App -> App: return
else Application en fonctionnement (_running == true)

    App -> App: deltaMs = ± _ui.nudgeMs

    App -> Engine: nudge(deltaMs)
    activate Engine
    Engine -> Engine: _phaseOffsetMs += deltaMs
    deactivate Engine

    alt Si audio en cours et running
        App -> Audio: nudge(deltaMs)
        activate Audio
        Audio -> Audio: _cycleStartAudioTime -= deltaMs / 1000
        deactivate Audio
        
        App -> Audio: recomputePlannedAfterNudge(engine)
        activate Audio
        Audio -> Audio: Recalcule événements planifiés\naprès le décalage
        deactivate Audio
        
        App -> Audio: schedulerTick(engine, isBeepEnabled)
        activate Audio
        Audio -> Audio: Re-planifie beeps et tingles
        deactivate Audio
    end

    note over App, Audio
      Le nudge permet de décaler
      la synchronisation sans
      redémarrer le cycle
    end note

end

deactivate App
deactivate UI

== Scénario 5: Changement de Paramètres ==

Utilisateur -> UI: Modifie durée d'apnée
activate UI
UI -> App: _onApneaChange()
activate App

App -> UI: readApneaMs()
activate UI
UI --> App: nouvelleValeur
deactivate UI

App -> App: deferChange = _running || _isPaused

App -> Engine: setApnea(nouvelleValeur, deferChange)
activate Engine

alt Si deferChange == true\n(application en marche ou en pause)
    Engine -> Engine: _pendingApnea = nouvelleValeur
    Engine -> Engine: _hasPending = true
    note right
      La nouvelle valeur est gardée
      en attente et sera appliquée
      au prochain rollover.
    end note
else Si deferChange == false\n(application réinitialisée ou avant démarrage)
    Engine -> Engine: _apneaMs = nouvelleValeur
    Engine -> Engine: _activeApnea = nouvelleValeur

    App -> Bar: updateMarkers(engine)
    activate Bar
    Bar -> Bar: Recalcule immédiatement\nles positions
    deactivate Bar
end

note over UI, Engine
  Pour Tbas, l'utilisateur ouvre d'abord
  un pavé numérique. Après validation,
  la logique reste identique :
  _onExpChange(), readExpSecAsMs(),
  puis setExp(nouvelleValeur, deferChange).
end note

deactivate Engine
deactivate App
deactivate UI

@enduml
